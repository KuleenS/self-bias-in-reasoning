# Copy to `.env` and fill in. Loaded automatically via python-dotenv.

# OpenRouter (unified access to open + frontier models)
OPENROUTER_API_KEY=

# Direct provider APIs (optional; used if a model spec targets them directly)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Hugging Face token — required for gated datasets (e.g. GPQA) and some models
HF_TOKEN=
