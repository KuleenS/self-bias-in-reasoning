#!/bin/bash
#SBATCH --job-name=selfbias_evaluate
#SBATCH --output=slurm-evaluate-%j.out
#SBATCH --error=slurm-evaluate-%j.out
#SBATCH --ntasks=1
#SBATCH --partition=nvl
#SBATCH --time=12:00:00
#SBATCH --cpus-per-task=4
#SBATCH --mem-per-cpu=32000
#SBATCH --gres=gpu:2
#SBATCH --account=ghadfie1
#SBATCH --mail-type=END,FAIL
#SBATCH --mail-user=ksasse1@jhu.edu
#
# One evaluator model per job; it judges a generator's chains (run generation first).
# Usage:
#   sbatch slurm/evaluate.job <EVALUATOR> <GENERATOR>                # all datasets
#   sbatch slurm/evaluate.job Qwen/Qwen3-32B microsoft/Phi-4-reasoning gsm8k folio
set -euo pipefail
EVAL="${1:?usage: sbatch evaluate.job EVALUATOR GENERATOR [DATASET ...]}"
GEN="${2:?usage: sbatch evaluate.job EVALUATOR GENERATOR [DATASET ...]}"
shift 2 || true

ARGS=(--evaluator "$EVAL" --generator "$GEN")
for d in "$@"; do ARGS+=(--dataset "$d"); done

uv run --extra vllm selfbias evaluate "${ARGS[@]}"
