#!/bin/bash
#SBATCH --job-name=selfbias_generate
#SBATCH --output=slurm-generate-%j.out
#SBATCH --error=slurm-generate-%j.out
#SBATCH --ntasks=1
#SBATCH --partition=nvl
#SBATCH --time=12:00:00
#SBATCH --cpus-per-task=4
#SBATCH --mem-per-cpu=32000
#SBATCH --gres=gpu:2
#SBATCH --account=ghadfie1
#SBATCH --mail-type=END,FAIL
#SBATCH --mail-user=ksasse1@jhu.edu
#
# One model per job (offline vLLM). Usage:
#   sbatch slurm/generate.job Qwen/Qwen3-32B                 # all datasets
#   sbatch slurm/generate.job Qwen/Qwen3-32B gsm8k folio     # specific datasets
set -euo pipefail
MODEL="${1:?usage: sbatch generate.job MODEL [DATASET ...]}"; shift || true

ARGS=(--model "$MODEL")
for d in "$@"; do ARGS+=(--dataset "$d"); done

uv run selfbias generate "${ARGS[@]}"
